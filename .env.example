# Firefox extension build-time public configuration (publishable key only)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-publishable-or-anon-key
VITE_DIAGNOSE_API_URL=https://YOUR-VERCEL-PROJECT.vercel.app/api/diagnose

# Server-only Vercel environment variables; NEVER put these in extension code
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-public-publishable-or-anon-key
GROQ_API_KEY=server-side-only
GROQ_MODEL=llama-3.3-70b-versatile
